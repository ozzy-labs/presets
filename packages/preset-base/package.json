{
  "name": "@ozzylabs/preset-base",
  "version": "1.0.0",
  "description": "OzzyLabs base preset for create-agentic-app: shared linters, formatters, hooks, and editor configuration.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "author": "ozzy-labs",
  "homepage": "https://github.com/ozzy-labs/presets/tree/main/packages/preset-base#readme",
  "bugs": "https://github.com/ozzy-labs/presets/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozzy-labs/presets.git",
    "directory": "packages/preset-base"
  },
  "keywords": [
    "ozzylabs",
    "preset",
    "create-agentic-app",
    "scaffolding",
    "linter",
    "formatter"
  ],
  "devDependencies": {
    "tsdown": "^0.21.7",
    "typescript": "^5.8.0",
    "vitest": "^4.1.1"
  }
}
